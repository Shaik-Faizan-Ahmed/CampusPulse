<%- include('../partials/header') %>

<div class="auth-page">
  <div class="auth-card" style="text-align: center;">
    <% if (org) { %>
      <div style="margin-bottom:1.5rem">
        <% if (org.logo) { %>
          <img src="<%= org.logo %>" alt="<%= org.name %>" style="width:48px;height:48px;border-radius:12px;object-fit:cover;margin-bottom:0.75rem">
        <% } else { %>
          <div style="width:48px;height:48px;background:var(--accent);border-radius:12px;display:inline-flex;align-items:center;justify-content:center;font-size:1.4rem;font-weight:800;color:#fff;margin-bottom:0.75rem"><%= org.name.charAt(0).toUpperCase() %></div>
        <% } %>
      </div>
    <% } %>
    
    <h2 class="auth-title">Verify Your Email</h2>
    <p class="auth-sub" style="margin-bottom: 2rem;">
      We've sent a 6-digit code to <strong><%= email %></strong>. <br>
      Please enter it below to verify your account.
    </p>

    <form action="<%= org ? '/' + org.slug + '/auth/verify-otp' : '/auth/verify-otp' %>" method="POST" style="text-align: left;">
      <input type="hidden" name="email" value="<%= email %>">
      <div class="form-group">
        <label for="otp">Verification Code</label>
        <input type="text" id="otp" name="otp" placeholder="123456" required autocomplete="one-time-code" style="font-size: 1.5rem; letter-spacing: 0.5rem; text-align: center; font-weight: bold; padding: 1rem;">
      </div>
      <div class="form-submit">
        <button type="submit" class="btn btn-primary" style="width: 100%;">
          Verify Account
        </button>
      </div>
    </form>

    <form action="<%= org ? '/' + org.slug + '/auth/resend-otp' : '/auth/resend-otp' %>" method="POST" style="margin-top: 1.5rem;">
      <input type="hidden" name="email" value="<%= email %>">
      <p class="form-link">
        Didn't receive the code? 
        <button type="submit" style="background: none; border: none; color: var(--accent); padding: 0; font: inherit; cursor: pointer; text-decoration: underline;">
          Resend OTP
        </button>
      </p>
    </form>
  </div>
</div>

<%- include('../partials/footer') %>
